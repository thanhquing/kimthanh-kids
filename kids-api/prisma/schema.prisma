// KimThanh Kids — Phase 0 (Tầng A: Platform / SaaS)
// Xem docs/ARCHITECTURE.md và docs/MULTI_TENANCY.md để hiểu thiết kế.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── ENUMS ─────────────────────────

// Tenancy & identity
enum TenancyMode {
  POOL
  SILO
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum UserType {
  PLATFORM
  TENANT
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_BILLING
}

enum TenantRole {
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  NURSE
  FINANCE
  PARENT
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

// Plan / pricing
enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BillingCurrency {
  VND
  USD
}

enum LimitMetric {
  STUDENTS
  TEACHERS
  CLASSROOMS
  SCHOOLS
  STORAGE_MB
  PUSH_PER_MONTH
  ADMIN_USERS
}

enum LimitEnforcement {
  HARD
  SOFT
}

// Subscription
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum BillingMode {
  GATEWAY
  MANUAL
  DEDICATED_FREE
}

enum SubscriptionChangeType {
  CREATE
  RENEW
  UPGRADE
  DOWNGRADE
  CANCEL
  REACTIVATE
  TRIAL_CONVERT
  EXPIRE
  SUSPEND
}

// Invoice / payment (PLATFORM → TENANT; khác hẳn học phí trường→phụ huynh)
enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  UNCOLLECTIBLE
}

enum PlatformInvoiceLineKind {
  SUBSCRIPTION
  PRORATION_CREDIT
  PRORATION_CHARGE
  OVERAGE
  DISCOUNT
  TAX
  ADJUSTMENT
}

enum PlatformPaymentProvider {
  VNPAY
  MOMO
  BANK_TRANSFER
  MANUAL
}

enum PlatformPaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

enum DiscountKind {
  PERCENT
  FIXED_AMOUNT
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ───────────────────── NHÓM 1: IDENTITY & TENANCY ─────────────────────

model Tenant {
  id               String       @id @default(uuid())
  slug             String       @unique
  code             String?      @unique // Mã trường human-friendly (vd "HOASEN2024") — search/chọn tenant ở login, độc lập subdomain
  legalName        String
  taxCode          String?      @unique // MST pháp nhân — định danh tài khoản, 1 MST = 1 trường (chống mở trùng)
  taxVerifiedAt    DateTime? // đã xác minh MST với cơ quan thuế (null = mới chỉ đúng format/checksum)
  status           TenantStatus @default(TRIAL) // cache; nguồn chân lý = Subscription
  tenancyMode      TenancyMode  @default(POOL)
  planTier         PlanTier     @default(STARTER)
  currentPeriodEnd DateTime? // cache cho SubscriptionGuard
  trialEndsAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?
  deletedAt        DateTime?

  settings     TenantSettings?
  schools      School[]
  memberships  Membership[]
  domains      TenantDomain[]
  subscription Subscription?

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model TenantSettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  displayName       String
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String?  @default("#2563eb")
  secondaryColor    String?
  emailFromName     String?
  emailFromAddr     String?
  supportEmail      String?
  locale            String   @default("vi-VN")
  timezone          String   @default("Asia/Ho_Chi_Minh")
  // Thông tin chứng từ/thanh toán (học phí trường→phụ huynh)
  taxCode           String? // MST trường — phục vụ quyết toán thuế
  invoiceAddress    String? // địa chỉ xuất hóa đơn
  bankBin           String? // mã ngân hàng napas (VietQR)
  bankAccountNumber String?
  bankAccountName   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tenant_settings")
}

model TenantDomain {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  host        String       @unique
  type        DomainType
  status      DomainStatus @default(PENDING)
  isPrimary   Boolean      @default(false)
  verifyToken String?
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("tenant_domains")
}

model School {
  id                   String                @id @default(uuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  name                 String
  code                 String
  moetCode             String? // mã trường trên CSDL ngành GD&ĐT (Bộ GD&ĐT) — định danh cơ sở chuẩn ngành
  address              String?
  phone                String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String?
  deletedAt            DateTime?
  memberships          Membership[]
  classrooms           Classroom[]
  students             Student[]
  pickupAuthorizations PickupAuthorization[]
  pickupLogs           PickupLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("schools")
}

model User {
  id                   String                @id @default(uuid())
  type                 UserType
  email                String? // định danh: email HOẶC phone (ít nhất 1)
  phone                String?
  passwordHash         String?
  fullName             String
  isActive             Boolean               @default(true)
  platformRole         PlatformRole? // chỉ set khi type=PLATFORM
  tenantId             String? // null nếu PLATFORM
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  memberships          Membership[]
  homeroomClasses      Classroom[]           @relation("HomeroomTeacher")
  childLinks           StudentParent[]       @relation("ParentLinks")
  assignments          StaffAssignment[]     @relation("StaffAssignments")
  pickupAuthorizations PickupAuthorization[] @relation("PickupParentUser")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([type])
  @@map("users")
}

model Membership {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        TenantRole
  schoolId    String? // null = role toàn tenant (chuỗi)
  school      School?    @relation(fields: [schoolId], references: [id])
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  createdById String?
  deletedAt   DateTime?

  @@unique([userId, role, schoolId])
  @@index([tenantId])
  @@index([userId])
  @@index([schoolId])
  @@map("memberships")
}

// ──────────────── NHÓM 2: PLAN / PRICING / FEATURE / LIMIT ────────────────

model Plan {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  tier        PlanTier  @default(STARTER)
  isPublic    Boolean   @default(true)
  isActive    Boolean   @default(true)
  trialDays   Int       @default(0)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  prices        PlanPrice[]
  features      PlanFeature[]
  limits        PlanLimit[]
  subscriptions Subscription[]

  @@index([isActive, isPublic])
  @@map("plans")
}

model PlanPrice {
  id           String          @id @default(uuid())
  planId       String
  plan         Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle
  currency     BillingCurrency @default(VND)
  amount       Decimal         @db.Decimal(12, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([planId, billingCycle, currency])
  @@map("plan_prices")
}

model PlanFeature {
  id         String  @id @default(uuid())
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  enabled    Boolean @default(true)
  config     Json?

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model PlanLimit {
  id               String           @id @default(uuid())
  planId           String
  plan             Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  metric           LimitMetric
  limitValue       Int? // null = unlimited
  enforcement      LimitEnforcement @default(HARD)
  overageUnitPrice Decimal?         @db.Decimal(12, 2)

  @@unique([planId, metric])
  @@map("plan_limits")
}

// ──────────────── NHÓM 3: SUBSCRIPTION & LỊCH SỬ ────────────────

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle
  currency           BillingCurrency    @default(VND)
  billingMode        BillingMode        @default(GATEWAY)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  endedAt            DateTime?
  pastDueSince       DateTime?
  suspendedAt        DateTime?
  entitlementsCache  Json? // {features, limits} — cache cho guard
  couponId           String?
  coupon             Coupon?            @relation(fields: [couponId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  invoices  PlatformInvoice[]
  changes   SubscriptionChange[]
  overrides TenantEntitlement[]
  usage     UsageCounter[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
  @@index([pastDueSince])
  @@map("subscriptions")
}

model SubscriptionChange {
  id              String                 @id @default(uuid())
  subscriptionId  String
  subscription    Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type            SubscriptionChangeType
  fromPlanId      String?
  toPlanId        String?
  fromCycle       BillingCycle?
  toCycle         BillingCycle?
  effectiveAt     DateTime
  prorationAmount Decimal?               @db.Decimal(12, 2)
  actorId         String?
  reason          String?
  metadata        Json?
  createdAt       DateTime               @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_changes")
}

// ──────────────── NHÓM 4: HÓA ĐƠN / THANH TOÁN NỀN TẢNG ────────────────

model PlatformInvoice {
  id             String                @id @default(uuid())
  invoiceNumber  String                @unique // {SLUG}-{GÓI}-{YYYYMMDD}-{NN}
  publicToken    String                @unique @default(uuid()) // link công khai /hoa-don/:token (không cần login)
  tenantId       String
  subscriptionId String?
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id])
  status         PlatformInvoiceStatus @default(DRAFT)
  currency       BillingCurrency       @default(VND)
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal               @default(0) @db.Decimal(12, 2)
  discount       Decimal               @default(0) @db.Decimal(12, 2)
  tax            Decimal               @default(0) @db.Decimal(12, 2)
  total          Decimal               @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal               @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  lines    PlatformInvoiceLine[]
  payments PlatformPayment[]
  credits  CreditLedger[]

  @@index([tenantId, status])
  @@index([status, dueAt])
  @@index([subscriptionId])
  @@map("platform_invoices")
}

model PlatformInvoiceLine {
  id        String                  @id @default(uuid())
  invoiceId String
  invoice   PlatformInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      PlatformInvoiceLineKind
  label     String
  quantity  Int                     @default(1)
  unitPrice Decimal                 @db.Decimal(12, 2)
  amount    Decimal                 @db.Decimal(12, 2) // có thể âm (credit/discount)
  metadata  Json?
  createdAt DateTime                @default(now())

  @@index([invoiceId])
  @@map("platform_invoice_lines")
}

model PlatformPayment {
  id             String                  @id @default(uuid())
  invoiceId      String
  invoice        PlatformInvoice         @relation(fields: [invoiceId], references: [id])
  tenantId       String
  provider       PlatformPaymentProvider
  status         PlatformPaymentStatus   @default(CREATED)
  amount         Decimal                 @db.Decimal(12, 2)
  currency       BillingCurrency         @default(VND)
  gatewayRef     String?
  redirectUrl    String?
  rawPayload     Json?
  expiresAt      DateTime?
  paidAt         DateTime?
  refundedAmount Decimal?                @db.Decimal(12, 2)
  refundedAt     DateTime?
  refundRef      String?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([provider, gatewayRef])
  @@index([invoiceId, status])
  @@index([tenantId, status])
  @@map("platform_payments")
}

model PlatformWebhookEvent {
  id          String                  @id @default(uuid())
  provider    PlatformPaymentProvider
  eventId     String?
  signature   String?
  payload     Json
  verified    Boolean                 @default(false)
  processed   Boolean                 @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime                @default(now())

  @@unique([provider, eventId])
  @@index([processed, createdAt])
  @@map("platform_webhook_events")
}

// Snapshot MRR theo tháng (platform-global, KHÔNG tenant-scoped) — nguồn cho biểu đồ doanh thu
// nhiều tháng. source=CRON là số thực chốt định kỳ; BACKFILL là số suy ngược lúc khởi tạo.
model MrrSnapshot {
  id          String            @id @default(uuid())
  periodMonth DateTime          @unique // 00:00 ngày 1 của tháng (mốc đại diện, UTC)
  mrr         Decimal           @default(0) @db.Decimal(14, 2)
  activeSubs  Int               @default(0)
  byTier      Json? // { FREE: number, STARTER: number, ... } — MRR (VND/tháng) theo tier
  source      MrrSnapshotSource @default(CRON)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([periodMonth])
  @@map("mrr_snapshots")
}

enum MrrSnapshotSource {
  CRON
  BACKFILL
}

/// Cấu hình NỀN TẢNG (1 hàng duy nhất, id="singleton"). Khác TenantSettings (cấu hình mỗi trường).
/// - Thông tin ngân hàng nền tảng → sinh VietQR cho tenant chuyển khoản (addInfo = số hóa đơn).
/// - Số ngày ân hạn dunning (đưa ENV ra UI để chỉnh): quá hạn → tạm khóa (pastDue) → hủy (suspended).
model PlatformConfig {
  id                 String   @id @default("singleton")
  bankBin            String? // mã ngân hàng NAPAS (VietQR)
  bankAccountNumber  String?
  bankAccountName    String?
  pastDueGraceDays   Int      @default(7)
  suspendedGraceDays Int      @default(14)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("platform_config")
}

// ──────────────── NỘI DUNG LANDING (platform-global) ────────────────

model PlatformPost {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  excerpt         String?
  contentMarkdown String
  coverImageUrl   String?
  category        String?
  tags            String[]
  status          PostStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  authorId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@map("platform_posts")
}

// ──────────────── NHÓM 5: ENTITLEMENT / USAGE / COUPON / CREDIT ────────────────

model TenantEntitlement {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  featureKey     String?
  enabled        Boolean?
  metric         LimitMetric?
  limitValue     Int?
  reason         String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@map("tenant_entitlements")
}

model UsageCounter {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  metric         LimitMetric
  value          Int           @default(0)
  periodStart    DateTime?
  periodEnd      DateTime?
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, metric])
  @@index([tenantId])
  @@map("usage_counters")
}

model Coupon {
  id             String           @id @default(uuid())
  code           String           @unique
  kind           DiscountKind
  amount         Decimal          @db.Decimal(12, 2)
  currency       BillingCurrency?
  duration       CouponDuration   @default(ONCE)
  durationCount  Int?
  maxRedemptions Int?
  redeemedCount  Int              @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@map("coupons")
}

model CreditLedger {
  id        String           @id @default(uuid())
  tenantId  String
  invoiceId String?
  invoice   PlatformInvoice? @relation(fields: [invoiceId], references: [id])
  amount    Decimal          @db.Decimal(12, 2) // + cấp / - tiêu
  currency  BillingCurrency  @default(VND)
  reason    String
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("credit_ledgers")
}

// ──────────────── AUDIT LOG (cross-cutting, hành động tài chính & admin) ────────────────

model AuditLog {
  id         String    @id @default(uuid())
  tenantId   String?
  actorId    String?
  actorType  UserType?
  action     String // "subscription.upgrade", "invoice.void", "tenant.suspend"...
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ──────────────── AUTH: REFRESH TOKEN ────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ════════════════════════ TẦNG B — DOMAIN (Phase 1) ════════════════════════
// Mọi bảng domain BẮT BUỘC có tenantId (bảo mật, scalar — extension auto-filter)
// + schoolId (nghiệp vụ). Thêm tên model vào TENANT_KEY của prisma-tenant.extension.

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

model Classroom {
  id                String            @id @default(uuid())
  tenantId          String
  schoolId          String
  school            School            @relation(fields: [schoolId], references: [id])
  name              String
  ageGroup          String?
  capacity          Int               @default(25)
  homeroomTeacherId String?
  homeroomTeacher   User?             @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  deletedAt         DateTime?
  students          Student[]
  attendance        Attendance[]
  dailyReports      DailyReport[]
  staffAssignments  StaffAssignment[]
  announcements     Announcement[]
  weeklyMenus       WeeklyMenu[]
  lessonPlans       LessonPlan[]
  albums            Album[]

  @@unique([schoolId, name])
  @@index([tenantId])
  @@index([schoolId])
  @@map("classrooms")
}

model Student {
  id                   String                @id @default(uuid())
  tenantId             String
  schoolId             String
  school               School                @relation(fields: [schoolId], references: [id])
  classroomId          String?
  classroom            Classroom?            @relation(fields: [classroomId], references: [id])
  fullName             String
  nickname             String?
  dateOfBirth          DateTime              @db.Date
  gender               Gender
  avatarUrl            String?
  status               StudentStatus         @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String?
  deletedAt            DateTime?
  parents              StudentParent[]
  attendance           Attendance[]
  dailyReports         DailyReport[]
  healthRecords        HealthRecord[]
  medicineRequests     MedicineRequest[]
  incidents            Incident[]
  allergies            Allergy[]
  leaveRequests        LeaveRequest[]
  tuitionInvoices      TuitionInvoice[]
  pickupAuthorizations PickupAuthorization[]
  pickupLogs           PickupLog[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([classroomId])
  @@map("students")
}

// Junction phụ huynh ↔ học sinh (N-N). parent = User role PARENT.
model StudentParent {
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId     String
  parent       User     @relation("ParentLinks", fields: [parentId], references: [id])
  tenantId     String
  relationship String // "Mẹ" | "Ba" | "Người giám hộ"...
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@id([studentId, parentId])
  @@index([tenantId])
  @@index([parentId])
  @@map("student_parents")
}

// ──────────── C — Điểm danh & Báo cáo hằng ngày (Phase 1) ────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum Mood {
  HAPPY
  NEUTRAL
  TIRED
  FUSSY
}

model Attendance {
  id           String           @id @default(uuid())
  tenantId     String
  schoolId     String
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId  String
  classroom    Classroom        @relation(fields: [classroomId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkInAt    DateTime?
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([classroomId, date])
  @@index([schoolId, date])
  @@map("attendance")
}

enum PickupAuthorizationStatus {
  ACTIVE
  REVOKED
}

enum PickupEventType {
  CHECK_IN
  CHECK_OUT
}

// Người được phép đưa/đón học sinh. Có thể là phụ huynh trong hệ thống (parentUserId)
// hoặc người được ủy quyền ngoài hệ thống, nên lưu tên/SĐT độc lập để vận hành tại cổng trường.
model PickupAuthorization {
  id            String                    @id @default(uuid())
  tenantId      String
  schoolId      String
  school        School                    @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId  String?
  parentUser    User?                     @relation("PickupParentUser", fields: [parentUserId], references: [id])
  guardianName  String
  guardianPhone String
  relationship  String?
  note          String?
  status        PickupAuthorizationStatus @default(ACTIVE)
  createdById   String?
  revokedAt     DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  logs          PickupLog[]

  @@index([tenantId])
  @@index([studentId, status])
  @@index([schoolId, status])
  @@map("pickup_authorizations")
}

// Nhật ký ra/vào tại cổng trường. CHECK_IN = đưa bé đến; CHECK_OUT = đón bé về.
model PickupLog {
  id              String               @id @default(uuid())
  tenantId        String
  schoolId        String
  school          School               @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorizationId String?
  authorization   PickupAuthorization? @relation(fields: [authorizationId], references: [id])
  eventType       PickupEventType
  guardianName    String
  guardianPhone   String?
  note            String?
  occurredAt      DateTime
  recordedById    String?
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@index([studentId, occurredAt])
  @@index([schoolId, occurredAt])
  @@map("pickup_logs")
}

model DailyReport {
  id          String             @id @default(uuid())
  tenantId    String
  schoolId    String
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String?
  classroom   Classroom?         @relation(fields: [classroomId], references: [id])
  date        DateTime           @db.Date
  mood        Mood?
  meals       String? // ăn uống
  nap         String? // ngủ trưa
  activities  String? // hoạt động
  note        String?
  authorId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  photos      DailyReportPhoto[]

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([classroomId, date])
  @@map("daily_reports")
}

model DailyReportPhoto {
  id        String      @id @default(uuid())
  tenantId  String
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media       @relation(fields: [mediaId], references: [id])
  caption   String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([tenantId])
  @@index([reportId, sortOrder])
  @@map("daily_report_photos")
}

// ──────────── Media (lưu trữ nội bộ, nén trước khi lưu) ────────────

enum MediaKind {
  REPORT_PHOTO
  ALBUM
  AVATAR
  DOCUMENT
  OTHER
}

model Media {
  id           String             @id @default(uuid())
  tenantId     String
  schoolId     String?
  kind         MediaKind          @default(OTHER)
  path         String // tương đối dưới MEDIA_ROOT: <tenantId>/<id>.webp
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  originalName String?
  uploadedById String?
  createdAt    DateTime           @default(now())
  albumPhotos  AlbumPhoto[]
  reportPhotos DailyReportPhoto[]

  @@index([tenantId])
  @@map("media")
}

// ──────────── D — Sức khỏe (Phase 1) ────────────

enum MedicineStatus {
  PENDING
  APPROVED
  ADMINISTERED
  REJECTED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LeaveType {
  SICK
  FAMILY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// D1 — Hồ sơ sức khỏe (y tá ghi: chiều cao/cân nặng/thân nhiệt). Nguồn dữ liệu biểu đồ tăng trưởng.
model HealthRecord {
  id           String   @id @default(uuid())
  tenantId     String
  schoolId     String
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  heightCm     Float?
  weightKg     Float?
  temperatureC Float?
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([studentId, date])
  @@index([schoolId])
  @@map("health_records")
}

// D2 — Yêu cầu cho uống thuốc: PH tạo → y tá duyệt/từ chối/đánh dấu đã cho uống.
model MedicineRequest {
  id            String                  @id @default(uuid())
  tenantId      String
  schoolId      String
  studentId     String
  student       Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  medicineName  String
  dosage        String
  schedule      String // giờ uống, dạng text: "8h, 14h"
  startDate     DateTime                @db.Date
  endDate       DateTime                @db.Date
  reason        String?
  status        MedicineStatus          @default(PENDING)
  requestedById String? // phụ huynh tạo
  handledById   String? // y tá/GV xử lý
  handledAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  history       MedicineStatusHistory[]

  @@index([tenantId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("medicine_requests")
}

// Timeline đổi trạng thái + ghi chú y tá cho mỗi yêu cầu thuốc.
model MedicineStatusHistory {
  id        String          @id @default(uuid())
  tenantId  String
  requestId String
  request   MedicineRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    MedicineStatus
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([tenantId])
  @@index([requestId, createdAt])
  @@map("medicine_status_history")
}

// D3 — Sự cố (té ngã, ốm…) — staff ghi, sẽ notify PH (đẩy sau).
model Incident {
  id           String           @id @default(uuid())
  tenantId     String
  schoolId     String
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  type         String // phân loại tự do: "Té ngã" | "Sốt" | "Xô xát"...
  severity     IncidentSeverity @default(LOW)
  description  String
  actionTaken  String?
  reportedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([schoolId, date])
  @@map("incidents")
}

// Dị ứng — dùng cảnh báo thực đơn (F3) về sau.
model Allergy {
  id        String   @id @default(uuid())
  tenantId  String
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergen  String
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, allergen])
  @@index([tenantId])
  @@map("allergies")
}

// ──────────── B3 — Phân công làm việc cho nhân sự (Phase 1) ────────────

enum Shift {
  MORNING
  AFTERNOON
  FULL_DAY
}

// Lịch phân công LẶP theo tuần: GV/nhân sự ↔ (lớp) theo thứ + ca. App GV xem "lịch của tôi".
model StaffAssignment {
  id          String     @id @default(uuid())
  tenantId    String
  schoolId    String
  staffId     String
  staff       User       @relation("StaffAssignments", fields: [staffId], references: [id], onDelete: Cascade)
  classroomId String? // null = nhiệm vụ không gắn lớp (trực trưa, đón trẻ...)
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  weekday     Int // 1=Thứ 2 ... 7=Chủ nhật (ISO)
  shift       Shift
  duty        String // "GV chính" | "GV phụ" | "Trực trưa" | "Đón trẻ"...
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([staffId, weekday, shift]) // 1 người chỉ 1 phân công cho mỗi (thứ, ca)
  @@index([tenantId])
  @@index([schoolId, weekday])
  @@index([classroomId])
  @@map("staff_assignments")
}

// D4 — Đơn xin nghỉ: PH tạo → GV/admin duyệt.
model LeaveRequest {
  id            String      @id @default(uuid())
  tenantId      String
  schoolId      String
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String?
  attachmentUrl String?
  status        LeaveStatus @default(PENDING)
  requestedById String? // phụ huynh tạo
  handledById   String? // GV/admin duyệt
  handledAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("leave_requests")
}

// ════════════════════════ E — HỌC PHÍ (trường → phụ huynh) ════════════════════════
// KHÁC billing nền tảng (Phase 0). Chứng từ in được, phục vụ quyết toán thuế / kế toán.

enum TuitionInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

enum TuitionPaymentMethod {
  CASH // tiền mặt (kế toán ghi nhận)
  BANK_TRANSFER // chuyển khoản VietQR (đối soát thủ công/ngân hàng)
  VNPAY // cổng VNPay (sandbox)
}

enum TuitionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model TuitionInvoice {
  id            String               @id @default(uuid())
  tenantId      String
  schoolId      String
  studentId     String
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber String // HD-YYYY-NNNN (tuần tự theo tenant + năm)
  period        String // "2026-06" | "HK1 2026-2027"...
  issueDate     DateTime             @db.Date
  dueDate       DateTime             @db.Date
  subtotal      Decimal              @default(0) @db.Decimal(12, 2)
  discount      Decimal              @default(0) @db.Decimal(12, 2)
  total         Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal              @default(0) @db.Decimal(12, 2)
  status        TuitionInvoiceStatus @default(UNPAID)
  note          String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         TuitionInvoiceItem[]
  payments      TuitionPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([schoolId, status])
  @@index([studentId])
  @@map("tuition_invoices")
}

model TuitionInvoiceItem {
  id        String         @id @default(uuid())
  tenantId  String
  invoiceId String
  invoice   TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String // "Học phí tháng 6", "Tiền ăn", "Xe đưa đón"...
  quantity  Int            @default(1)
  unitPrice Decimal        @db.Decimal(12, 2)
  amount    Decimal        @db.Decimal(12, 2)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("tuition_invoice_items")
}

model TuitionPayment {
  id           String               @id @default(uuid())
  tenantId     String
  schoolId     String
  invoiceId    String
  invoice      TuitionInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method       TuitionPaymentMethod
  status       TuitionPaymentStatus @default(PENDING)
  amount       Decimal              @db.Decimal(12, 2)
  reference    String? // mã chuyển khoản / ghi chú đối soát
  gatewayRef   String? // mã giao dịch cổng (VNPay vnp_TxnRef)
  paidAt       DateTime?
  rawPayload   Json?
  recordedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([method, gatewayRef])
  @@index([tenantId])
  @@index([invoiceId, status])
  @@map("tuition_payments")
}

// ════════════════════════ F — GIAO TIẾP & NỘI DUNG (Phase 1) ════════════════════════

enum AnnouncementAudience {
  ALL // toàn trường
  PARENTS // chỉ phụ huynh
  TEACHERS // chỉ nhân sự
  CLASS // 1 lớp (classroomId)
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

// F1 — Thông báo: soạn theo phạm vi (audience), PH/GV xem feed.
model Announcement {
  id          String               @id @default(uuid())
  tenantId    String
  schoolId    String
  audience    AnnouncementAudience @default(ALL)
  classroomId String? // bắt buộc khi audience=CLASS
  classroom   Classroom?           @relation(fields: [classroomId], references: [id])
  title       String
  body        String
  publishedAt DateTime? // null = nháp
  authorId    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([schoolId, publishedAt])
  @@index([classroomId])
  @@map("announcements")
}

// F3 — Thực đơn tuần + bữa ăn (cảnh báo dị ứng đối chiếu Allergy).
model WeeklyMenu {
  id          String     @id @default(uuid())
  tenantId    String
  schoolId    String
  classroomId String? // null = áp dụng toàn trường
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  weekStart   DateTime   @db.Date // thứ 2 đầu tuần
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  meals       Meal[]

  @@index([tenantId])
  @@index([schoolId, weekStart])
  @@map("weekly_menus")
}

model Meal {
  id          String     @id @default(uuid())
  tenantId    String
  menuId      String
  menu        WeeklyMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  weekday     Int // 1=Thứ 2 ... 7=CN
  mealType    MealType
  name        String // "Cơm gà, canh rau"
  ingredients String? // liệt kê nguyên liệu — dùng dò dị ứng

  @@index([tenantId])
  @@index([menuId])
  @@map("meals")
}

// F4 — Giáo án tuần (GV nội bộ, @RequireFeature lesson_plan).
model LessonPlan {
  id          String     @id @default(uuid())
  tenantId    String
  schoolId    String
  classroomId String
  classroom   Classroom  @relation(fields: [classroomId], references: [id])
  week        String // "2026-W27" | ngày đầu tuần
  theme       String
  note        String?
  authorId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  Activity[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([classroomId, week])
  @@map("lesson_plans")
}

model Activity {
  id        String     @id @default(uuid())
  tenantId  String
  planId    String
  plan      LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1..7
  startTime String? // "08:00"
  title     String
  materials String?

  @@index([tenantId])
  @@index([planId])
  @@map("activities")
}

// F5 — Album ảnh lớp cho PH xem (@RequireFeature media_gallery), tái dùng Media.
model Album {
  id          String       @id @default(uuid())
  tenantId    String
  schoolId    String
  classroomId String? // null = album toàn trường
  classroom   Classroom?   @relation(fields: [classroomId], references: [id])
  title       String
  description String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  photos      AlbumPhoto[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([classroomId])
  @@map("albums")
}

model AlbumPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id])
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([albumId])
  @@map("album_photos")
}

// ════════════════════════ G — THÔNG BÁO / DASHBOARD / OBSERVABILITY (Phase 1) ════════════════════════

enum NotificationType {
  ATTENDANCE
  DAILY_REPORT
  ANNOUNCEMENT
  INVOICE
  MEDICINE
  LEAVE
  INCIDENT
}

// Thông báo in-app gửi tới 1 người dùng (PH/GV). Push FCM đẩy sau, tái dùng cùng điểm phát.
model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String // người nhận
  type      NotificationType
  title     String
  body      String?
  linkType  String? // "TuitionInvoice" | "DailyReport" | "Announcement"...
  linkId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

// Tuỳ chọn bật/tắt theo loại; chỉ lưu khi user GHI ĐÈ mặc định (mặc định coi như bật).
model NotificationPreference {
  id       String           @id @default(uuid())
  tenantId String
  userId   String
  type     NotificationType
  enabled  Boolean          @default(true)

  @@unique([userId, type])
  @@index([tenantId])
  @@map("notification_preferences")
}

// Event log generic cho metric vận hành (DAU/MAU, feature-hit). Operator đọc cross-tenant qua prisma.system.
model UsageEvent {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  type      String // "login" | "signup" | "feature.lesson_plan"...
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("usage_events")
}
