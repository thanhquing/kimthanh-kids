# ─── App ───
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ───
DATABASE_URL=postgresql://kids:kids@localhost:5432/kids_api?schema=public

# ─── Auth (JWT) — đổi secret thật khi production, tối thiểu 32 ký tự ───
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
JWT_REFRESH_TTL=30d

# ─── Multi-tenancy ───
# Domain gốc để resolve subdomain: <slug>.kimthanhkids.vn
ROOT_DOMAIN=kimthanhkids.vn
PLATFORM_HOST=admin.kimthanhkids.vn
API_HOST=api.kimthanhkids.vn
# SILO (deploy riêng cho 1 trường): set TENANCY_MODE=SILO + FIXED_TENANT_ID
TENANCY_MODE=POOL
FIXED_TENANT_ID=

# ─── Reverse proxy & rate limit ───
# Số hop proxy tin cậy (X-Forwarded-For). Prod sau nginx/LB thường =1; để 0 để tắt.
TRUST_PROXY=1
# Rate limit chung mọi route
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Rate limit chặt cho /auth/login + /auth/refresh (chống brute-force)
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# ─── Mật khẩu & account lockout ───
# bcrypt cost 10-15 (cao hơn = chậm hơn, an toàn hơn); 12 là khuyến nghị OWASP
BCRYPT_COST=12
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15

# ─── Billing / dunning ───
PAST_DUE_GRACE_DAYS=7
SUSPENDED_GRACE_DAYS=14

# ─── Payment gateway (VNPay) — điền khi tích hợp/gọi thanh toán VNPay ───
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL cổng thanh toán — không default trong code; thiếu sẽ trả VNPAY_NOT_CONFIGURED khi gọi VNPay.
# Dev dùng sandbox dưới đây; prod nếu bật VNPay PHẢI trỏ endpoint thật (app fail-fast nếu còn "sandbox").
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL app hiển thị kết quả sau thanh toán; bắt buộc khi gọi VNPay.
VNPAY_RETURN_URL=http://localhost:5173/payment-result

# ─── Media (lưu trữ ảnh nội bộ + nén webp) ───
# Thư mục gốc lưu file (đường dẫn tương đối process.cwd hoặc tuyệt đối).
MEDIA_ROOT=storage
# Cạnh dài nhất sau khi resize (px).
MEDIA_MAX_DIM=1280
# Chất lượng webp 40-95 (đủ cho phụ huynh xem, tiết kiệm dung lượng).
MEDIA_QUALITY=72
