// =====================================================
// KimThanh Kindergarten — Prisma schema
// Multi-tenant by School. UUID PKs, timestamps, soft delete.
// Keep enum values in sync with packages/shared-types/src/enums.ts
// =====================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  NURSE
  TEACHER
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MedicineRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ADMINISTERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
  STAFF
  CLASS
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum Locale {
  vi
  en
}

// ---------- Tenant ----------

model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users         User[]
  classrooms    Classroom[]
  students      Student[]
  announcements Announcement[]
  invoices      TuitionInvoice[]

  @@map("schools")
}

// ---------- Identity ----------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  locale       Locale     @default(vi)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens     RefreshToken[]
  parentLinks       StudentParent[]    @relation("ParentLink")
  homeroomClasses   Classroom[]        @relation("HomeroomTeacher")
  attendanceRecords Attendance[]       @relation("AttendanceRecorder")
  dailyReports      DailyReport[]      @relation("ReportAuthor")
  medicineRequests  MedicineRequest[]  @relation("MedicineRequester")
  handledMedicine   MedicineRequest[]  @relation("MedicineHandler")
  healthRecords     HealthRecord[]     @relation("HealthRecorder")
  incidents         Incident[]         @relation("IncidentReporter")
  announcements     Announcement[]     @relation("AnnouncementAuthor")
  uploadedMedia     Media[]            @relation("MediaUploader")
  paymentsRecorded  Payment[]          @relation("PaymentRecorder")

  @@index([schoolId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- School structure ----------

model Classroom {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  name              String
  ageGroup          String
  capacity          Int      @default(20)
  homeroomTeacherId String?
  homeroomTeacher   User?    @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students      Student[]
  attendance    Attendance[]
  dailyReports  DailyReport[]
  announcements Announcement[]
  media         Media[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classrooms")
}

model Student {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  fullName    String
  nickname    String?
  dateOfBirth DateTime
  gender      Gender
  avatarUrl   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parents          StudentParent[]
  attendance       Attendance[]
  dailyReports     DailyReport[]
  medicineRequests MedicineRequest[]
  healthRecords    HealthRecord[]
  incidents        Incident[]
  invoices         TuitionInvoice[]
  media            MediaStudent[]

  @@index([schoolId])
  @@index([classroomId])
  @@map("students")
}

model StudentParent {
  studentId    String
  parentId     String
  relationship String?
  isPrimary    Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

// ---------- Operations ----------

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id])
  date        DateTime         @db.Date
  status      AttendanceStatus
  checkInAt   DateTime?
  checkOutAt  DateTime?
  note        String?
  recordedById String
  recordedBy  User             @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([classroomId, date])
  @@map("attendance")
}

model DailyReport {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  date        DateTime @db.Date
  mood        String?
  meals       String?
  nap         String?
  activities  String?
  note        String?
  authorId    String
  author      User     @relation("ReportAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media MediaReport[]

  @@unique([studentId, date])
  @@index([classroomId, date])
  @@map("daily_reports")
}

// ---------- Health ----------

model MedicineRequest {
  id            String                @id @default(uuid())
  studentId     String
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                  @relation("MedicineRequester", fields: [requestedById], references: [id])
  medicineName  String
  dosage        String
  schedule      String
  startDate     DateTime              @db.Date
  endDate       DateTime              @db.Date
  reason        String?
  status        MedicineRequestStatus @default(PENDING)
  handledById   String?
  handledBy     User?                 @relation("MedicineHandler", fields: [handledById], references: [id])
  handledAt     DateTime?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@map("medicine_requests")
}

model HealthRecord {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  heightCm      Decimal? @db.Decimal(5, 2)
  weightKg      Decimal? @db.Decimal(5, 2)
  temperatureC  Decimal? @db.Decimal(4, 2)
  notes         String?
  recordedById  String
  recordedBy    User     @relation("HealthRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, date])
  @@map("health_records")
}

model Incident {
  id            String           @id @default(uuid())
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  description   String
  severity      IncidentSeverity @default(LOW)
  actionTaken   String?
  reportedById  String
  reportedBy    User             @relation("IncidentReporter", fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, date])
  @@map("incidents")
}

// ---------- Finance ----------

model TuitionInvoice {
  id            String        @id @default(uuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  period        String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("VND")
  dueDate       DateTime      @db.Date
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([studentId, period])
  @@index([schoolId, status])
  @@map("tuition_invoices")
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("VND")
  method      String
  reference   String?
  paidAt      DateTime
  recordedById String
  recordedBy  User     @relation("PaymentRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("payments")
}

// ---------- Communications ----------

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  school      School               @relation(fields: [schoolId], references: [id])
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  classroomId String?
  classroom   Classroom?           @relation(fields: [classroomId], references: [id])
  publishedAt DateTime?
  authorId    String
  author      User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, publishedAt])
  @@map("announcements")
}

// ---------- Media ----------

model Media {
  id           String     @id @default(uuid())
  type         MediaType
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationMs   Int?
  uploadedById String
  uploadedBy   User       @relation("MediaUploader", fields: [uploadedById], references: [id])
  classroomId  String?
  classroom    Classroom? @relation(fields: [classroomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students MediaStudent[]
  reports  MediaReport[]

  @@index([classroomId])
  @@map("media")
}

model MediaStudent {
  mediaId   String
  studentId String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([mediaId, studentId])
  @@map("media_students")
}

model MediaReport {
  mediaId  String
  reportId String
  media    Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([mediaId, reportId])
  @@map("media_reports")
}
