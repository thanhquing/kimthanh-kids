{
  "expo": {
    "name": "KimThanh",
    "slug": "kimthanh-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "kimthanh",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6F0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "school.kimthanh.app" },
    "android": { "package": "school.kimthanh.app", "adaptiveIcon": { "backgroundColor": "#FF6F0A" } },
    "plugins": ["expo-localization", "expo-secure-store"]
  }
}
