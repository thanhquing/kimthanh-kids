# =====================================================
# KimThanh Kindergarten — Environment Variables Template
# Copy to .env (root) or per-app and fill in real values.
# =====================================================

# ---- API (apps/api) ----
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kimthanh?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_TTL=30d

# Storage (S3-compatible, future)
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=kimthanh-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# ---- Mobile (apps/mobile) ----
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_DEFAULT_LOCALE=vi
